# Provider-neutral staging contract. Staging may enable Polygon testnet
# anchoring after review, but this example keeps the mock anchor backend.
PQFABRIC_DEPLOYMENT_PROFILE=staging
PQ_FABRIC_CRYPTO_SUITE=pq
PQ_FABRIC_PRODUCTION_MODE=true
PQFABRIC_API_KEYS_FILE=/etc/pq-fabric/secrets/api-keys.json
PQFABRIC_CONSORTIUM_MANIFEST=/etc/pq-fabric/manifest/current.json
PQFABRIC_CONSORTIUM_MANIFEST_HISTORY=/etc/pq-fabric/manifest/history/v1.json,/etc/pq-fabric/manifest/current.json
PQFABRIC_ACTIVE_VALIDATORS=7
PQFABRIC_SIGNER_PROVIDER=cloud-kms
PQFABRIC_ALLOW_LOCAL_SIGNER=false
PQFABRIC_KMS_KEY_REF=manifest-signing-key-ref
PQFABRIC_KMS_ENDPOINT=https://kms-signing-gateway.example.invalid
PQFABRIC_KMS_TOKEN=from-secret-ref
PQFABRIC_KMS_CA_FILE=/etc/pq-fabric/kms/ca.crt
PQFABRIC_KMS_ALLOW_INSECURE=false
PQFABRIC_DATABASE_URL=/data/validator.db
PQFABRIC_PEER_TLS_CERT_FILE=/etc/pq-fabric/tls/${NODE_ID}.crt
PQFABRIC_PEER_TLS_KEY_FILE=/etc/pq-fabric/tls/${NODE_ID}.key
PQFABRIC_PEER_TLS_CA_FILE=/etc/pq-fabric/tls/ca.crt
PQFABRIC_OPS_LISTEN_ADDR=:8090
PQFABRIC_RATE_LIMIT_PER_MINUTE=60
PQFABRIC_RATE_LIMIT_BURST=20
PQFABRIC_LOG_FORMAT=json
PQFABRIC_OTEL_ENABLED=false
PQFABRIC_OTEL_SERVICE_NAME=pq-fabric-validator
PQFABRIC_OTEL_EXPORTER_OTLP_ENDPOINT=
PQFABRIC_OTEL_EXPORTER_OTLP_HEADERS=
PQFABRIC_OTEL_EXPORTER_OTLP_INSECURE=false
STORAGE=sqlite
QUORUM_THRESHOLD=5
THRESHOLD=5
ROUTING_MODE=private-testbed
ANCHOR_BACKEND=mock
PUBLIC_EXIT_ROUTING=false
POLYGON_MAINNET_ENABLED=false
